@model System.Web.Mvc.HandleErrorInfo
@{
    // Trang lỗi chung dùng cho HandleErrorAttribute (App_Start/FilterConfig.cs).
    // Không dùng _Layout để trang lỗi vẫn hiển thị được kể cả khi chính layout gặp lỗi.
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đã xảy ra lỗi - FruitBen Shop</title>
    <link rel="stylesheet" href="~/assets/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/css/all.min.css" />
</head>
<body style="background: #f5f5f5; font-family: 'Open Sans', Arial, sans-serif; color: #051922;">
    <div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
        <div class="text-center p-5" style="max-width: 560px; background: #fff; border-radius: 5px; box-shadow: 0 0 20px #e4e4e4;">
            <div style="display: inline-flex; width: 84px; height: 84px; align-items: center; justify-content: center; font-size: 2.2rem; color: #F28123; border: 2px dashed #F28123; border-radius: 50%;"><i class="fas fa-exclamation-triangle"></i></div>
            <h2 class="mt-4" style="font-weight: 700;">Rất tiếc, đã xảy ra lỗi</h2>
            <p class="mt-2 mb-4" style="color: #777;">
                Hệ thống gặp sự cố khi xử lý yêu cầu của bạn. Vui lòng thử lại sau ít phút
                hoặc liên hệ FruitBen nếu lỗi vẫn tiếp diễn.
            </p>
            <div>
                <a href="@Url.Action("Index", "Home")" class="px-4 py-2" style="display: inline-block; background: #F28123; color: #fff; font-weight: 700; text-decoration: none; border-radius: 50px;">
                    <i class="fas fa-home mr-1"></i> Về trang chủ
                </a>
            </div>
        </div>
    </div>
</body>
</html>
