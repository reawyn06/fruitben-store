@model ShopHoaQua.Models.LienHe
@{
    ViewBag.TieuDeTrang = "Liên hệ";
}

<section class="fb-card fb-page-head">
    <div>
        <span class="fb-eyebrow"><i class="fas fa-headset"></i> Hỗ trợ khách hàng</span>
        <h1>Liên hệ FruitBen</h1>
        <p>Cần tư vấn chọn trái cây, đặt giỏ quà hay đổi trả? Gửi lời nhắn, FruitBen phản hồi trong vòng 24 giờ.</p>
    </div>
    <img class="fb-page-head-img" src="~/assets/img/hero-bg.jpg" alt="Trái cây tươi trên bàn gỗ" />
</section>

<div class="fb-info-grid mt-4">
    <div class="fb-info"><i class="fas fa-map-marker-alt"></i><h3>Cửa hàng</h3><p>140 Lê Trọng Tấn, Phường Tây Thạnh, TP. Hồ Chí Minh</p></div>
    <div class="fb-info"><i class="fas fa-phone"></i><h3>Hotline</h3><p>1900 1234<br />8:00 – 21:00 mỗi ngày</p></div>
    <div class="fb-info"><i class="fas fa-envelope"></i><h3>Email</h3><p>fruitben@gmail.com</p></div>
</div>

<div class="fb-checkout mt-4">
    <section class="fb-card fb-card-pad">
        <div class="fb-box-head">
            <div>
                <span class="fb-eyebrow">Gửi phản hồi</span>
                <h3 class="mt-2">Để lại lời nhắn cho chúng tôi</h3>
            </div>
            <span class="fb-box-icon"><i class="fas fa-paper-plane"></i></span>
        </div>

        @if (TempData["ThongBaoLienHe"] != null)
        {
            <div class="fb-note-box mb-3" style="background: var(--fb-green-soft); border-left-color: var(--fb-green); color: var(--fb-green-dark); font-weight: 600;">
                <i class="fas fa-check-circle"></i> @TempData["ThongBaoLienHe"]
            </div>
        }

        @using (Html.BeginForm("Index", "LienHe", FormMethod.Post, new { id = "fruitben-contact" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "fb-error mb-3" })

            <div class="form-row">
                <div class="col-md-6 fb-field">
                    @Html.LabelFor(m => m.HoTen)
                    <div class="fb-input-icon"><i class="far fa-user"></i>
                        @Html.TextBoxFor(m => m.HoTen, new { @class = "fb-control", placeholder = "Họ và tên của bạn", autocomplete = "name" })
                    </div>
                    @Html.ValidationMessageFor(m => m.HoTen)
                </div>
                <div class="col-md-6 fb-field">
                    @Html.LabelFor(m => m.Email)
                    <div class="fb-input-icon"><i class="far fa-envelope"></i>
                        @Html.TextBoxFor(m => m.Email, new { @class = "fb-control", placeholder = "ban@gmail.com", type = "email", autocomplete = "email" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email)
                </div>
            </div>
            <div class="form-row">
                <div class="col-md-6 fb-field">
                    @Html.LabelFor(m => m.SoDienThoai)
                    <div class="fb-input-icon"><i class="fas fa-phone"></i>
                        @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "fb-control", placeholder = "0901234567", inputmode = "tel" })
                    </div>
                    @Html.ValidationMessageFor(m => m.SoDienThoai)
                </div>
                <div class="col-md-6 fb-field">
                    @Html.LabelFor(m => m.ChuDe)
                    <div class="fb-input-icon"><i class="fas fa-tag"></i>
                        @Html.TextBoxFor(m => m.ChuDe, new { @class = "fb-control", placeholder = "Ví dụ: Đặt giỏ quà Tết" })
                    </div>
                    @Html.ValidationMessageFor(m => m.ChuDe)
                </div>
            </div>
            <div class="fb-field">
                @Html.LabelFor(m => m.TinNhan)
                @Html.TextAreaFor(m => m.TinNhan, new { @class = "fb-control", rows = 5, placeholder = "Nội dung bạn cần hỗ trợ..." })
                @Html.ValidationMessageFor(m => m.TinNhan)
            </div>
            <button type="submit" class="fb-btn fb-btn-grad fb-btn-lg"><i class="fas fa-paper-plane"></i> Gửi lời nhắn</button>
        }
    </section>

    <aside class="fb-card fb-card-pad fb-sticky">
        <div class="fb-box-head">
            <h3>Câu hỏi thường gặp</h3>
            <span class="fb-box-icon"><i class="fas fa-question"></i></span>
        </div>
        <div class="fb-prose" style="font-size: .9rem;">
            <p><b>Bao lâu nhận được hàng?</b><br />Nội thành TP. Hồ Chí Minh giao trong ngày nếu đặt trước 16h; tỉnh khác 1–3 ngày.</p>
            <p><b>Trái bị dập thì sao?</b><br />Chụp ảnh và báo trong 24 giờ, FruitBen đổi mới hoặc hoàn tiền. <a href="@Url.Action("DoiTra", "Home")">Xem chính sách đổi trả</a>.</p>
            <p class="mb-0"><b>Có xuất hoá đơn công ty không?</b><br />Có, ghi thông tin công ty ở ô Ghi chú khi đặt hàng.</p>
        </div>
        <div class="mt-3" style="overflow: hidden; border-radius: 5px; box-shadow: var(--fb-shadow);">
            <iframe title="Bản đồ cửa hàng FruitBen" src="https://www.google.com/maps?q=140+L%C3%AA+Tr%E1%BB%8Dng+T%E1%BA%A5n,+T%C3%A2y+Th%E1%BA%A1nh,+H%E1%BB%93+Ch%C3%AD+Minh&output=embed"
                    width="100%" height="220" style="border: 0; display: block;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </aside>
</div>
