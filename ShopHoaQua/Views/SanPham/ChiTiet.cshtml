@model ShopHoaQua.Models.SanPham
@{
    ViewBag.TieuDeTrang = Model.TenSanPham;
    ViewBag.Banner = "Xem thêm chi tiết";          // banner đầu trang (giao diện mẫu Fruitkha)
    ViewBag.BannerTieuDe = "Chi tiết sản phẩm";
    var lienQuan = ViewBag.SanPhamLienQuan as List<ShopHoaQua.Models.SanPham>;
    var daBan = (int)(ViewBag.DaBan ?? 0);
    var conHang = Model.ConHang && Model.SoLuongTon > 0;
    var dsAnh = new List<string>();
    if (!string.IsNullOrEmpty(Model.HinhAnh)) { dsAnh.Add(Model.HinhAnh); }
    dsAnh.AddRange(Model.HinhAnhPhu.OrderBy(a => a.ThuTu).Select(a => a.TenFile));
    var toiDa = Math.Min(Model.SoLuongTon, 50);
}

<nav class="fb-breadcrumb" aria-label="Đường dẫn">
    <a href="@Url.Action("Index", "Home")">Trang chủ</a> <i class="fas fa-chevron-right"></i>
    <a href="@Url.Action("Index", "SanPham")">Cửa hàng</a> <i class="fas fa-chevron-right"></i>
    <a href="@Url.Action("Index", "SanPham", new { loai = Model.Loai })">@Model.Loai</a> <i class="fas fa-chevron-right"></i>
    <span class="hien-tai">@Model.TenSanPham</span>
</nav>

<!-- 1. ẢNH + THÔNG TIN MUA (giống trang chi tiết SPORTIX) -->
<section class="fb-card fb-detail">
    <div>
        <div class="fb-gallery-main">
            <img id="anhChinh" src="~/assets/img/products/@(dsAnh.FirstOrDefault())" alt="@Model.TenSanPham" />
            @if (Model.DangGiamGia)
            {
                <span class="fb-tag sale">Sale</span>
            }
            else if (Model.LaHangMoi)
            {
                <span class="fb-tag">Mới</span>
            }
        </div>
        @if (dsAnh.Count > 1)
        {
            <div class="fb-thumbs">
                @for (int i = 0; i < dsAnh.Count; i++)
                {
                    <button type="button" class="@(i == 0 ? "active" : "")" data-src="@Url.Content("~/assets/img/products/" + dsAnh[i])" aria-label="Xem ảnh @(i + 1)">
                        <img src="~/assets/img/products/@dsAnh[i]" alt="" loading="lazy" />
                    </button>
                }
            </div>
        }
    </div>

    <div class="fb-detail-info">
        <div class="fb-detail-top">
            <span class="fb-pill">@Model.Loai</span>
            @if (!Model.ConHang)
            {
                <span class="fb-pill bad"><i class="fas fa-ban"></i> Ngừng kinh doanh</span>
            }
            else if (Model.SoLuongTon <= 0)
            {
                <span class="fb-pill bad"><i class="fas fa-times-circle"></i> Hết hàng</span>
            }
            else if (Model.SoLuongTon <= 10)
            {
                <span class="fb-pill warn"><i class="fas fa-exclamation-circle"></i> Chỉ còn @Model.SoLuongTon kg</span>
            }
            else
            {
                <span class="fb-pill ok"><i class="fas fa-check-circle"></i> Còn hàng</span>
            }
        </div>

        <h1>@Model.TenSanPham</h1>
        <p class="text-muted mb-2" style="font-size: .88rem;"><i class="fas fa-shopping-bag"></i> Đã bán @daBan kg · Kho còn @Model.SoLuongTon kg</p>

        <div class="fb-detail-price">
            <span class="fb-price">@Model.Gia.ToString("#,##0")đ</span>
            <span class="fb-unit">/ kg</span>
            @if (Model.DangGiamGia)
            {
                <span class="fb-old-price" style="font-size: 1.05rem;">@Model.GiaCu.Value.ToString("#,##0")đ</span>
                <span class="fb-sale-pill">-@Model.PhanTramGiam%</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.MoTa))
        {
            <p style="color: #555;">@Model.MoTa</p>
        }

        @using (Html.BeginForm("ThemVaoGio", "GioHang", FormMethod.Post, new { id = "formMua" }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("sanPhamId", Model.SanPhamId)

            <div class="fb-qty-box">
                <div>
                    <strong>Số lượng (kg)</strong>
                    <small>@(conHang ? "Tối đa " + toiDa + " kg mỗi lần đặt" : "Tạm thời chưa thể đặt")</small>
                </div>
                <div class="fb-qty" data-qty>
                    <button type="button" data-step="-1" aria-label="Giảm">−</button>
                    <input type="number" name="soLuong" id="soLuong" value="1" min="1" max="@(conHang ? toiDa : 1)" aria-label="Số kg" @(conHang ? "" : "disabled") />
                    <button type="button" data-step="1" aria-label="Tăng">+</button>
                </div>
            </div>

            <div class="fb-buy-row">
                <button type="submit" class="fb-btn fb-btn-grad fb-btn-lg" @(conHang ? "" : "disabled")>
                    <i class="fas fa-cart-plus"></i> Thêm vào giỏ hàng
                </button>
                <button type="submit" name="muaNgay" value="true" class="fb-btn fb-btn-soft fb-btn-lg" @(conHang ? "" : "disabled")>
                    Mua ngay <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        }

        <ul class="fb-promise">
            <li><i class="fas fa-shipping-fast"></i> Miễn phí giao hàng cho đơn từ 500.000đ</li>
            <li><i class="fas fa-undo-alt"></i> Đổi trái dập, hỏng trong 24 giờ sau khi nhận</li>
            <li><i class="fas fa-leaf"></i> Bảo quản lạnh từ kho đến tay bạn</li>
        </ul>
    </div>
</section>

<!-- 2. TAB MÔ TẢ / THÔNG TIN / BẢO QUẢN -->
<section class="fb-card fb-tabs mt-4 reveal">
    <ul class="nav" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#tabMoTa" role="tab">Mô tả</a></li>
        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tabThongTin" role="tab">Thông tin</a></li>
        <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tabBaoQuan" role="tab">Bảo quản</a></li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane fade show active" id="tabMoTa" role="tabpanel">
            <p class="mb-0" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.MoTa) ? "Sản phẩm đang được cập nhật mô tả." : Model.MoTa)</p>
        </div>
        <div class="tab-pane fade" id="tabThongTin" role="tabpanel">
            <table class="fb-spec">
                <tr><th>Loại</th><td>@Model.Loai</td></tr>
                <tr><th>Giá bán</th><td>@Model.Gia.ToString("#,##0")đ / kg</td></tr>
                <tr><th>Tồn kho</th><td>@Model.SoLuongTon kg</td></tr>
                <tr><th>Đã bán</th><td>@daBan kg</td></tr>
                <tr><th>Ngày lên kệ</th><td>@Model.NgayTao.ToString("dd/MM/yyyy")</td></tr>
                <tr><th>Mã sản phẩm</th><td>SP@(Model.SanPhamId.ToString("D4"))</td></tr>
            </table>
        </div>
        <div class="tab-pane fade" id="tabBaoQuan" role="tabpanel">
            <ul class="mb-0">
                <li>Rửa sạch ngay trước khi ăn, không rửa trước khi cất tủ lạnh để trái không bị úng.</li>
                <li>Trái mềm (dâu, nho, việt quất) để ngăn mát 2–5°C, dùng trong 3–4 ngày.</li>
                <li>Trái cứng (táo, lê, cam) để nơi thoáng mát hoặc ngăn mát, dùng trong 1–2 tuần.</li>
                <li>Trái nhiệt đới chưa chín (xoài, bơ, sầu riêng) để ở nhiệt độ phòng cho chín tự nhiên.</li>
            </ul>
        </div>
    </div>
</section>

@if (lienQuan != null && lienQuan.Any())
{
    <!-- 3. SẢN PHẨM LIÊN QUAN -->
    <section class="fb-section reveal">
        <div class="fb-section-head">
            <div>
                <span class="fb-eyebrow">Gợi ý cho bạn</span>
                <h2>Cùng loại @Model.Loai.ToLower()</h2>
            </div>
            <a class="fb-btn fb-btn-grad" href="@Url.Action("Index", "SanPham", new { loai = Model.Loai })">Xem tất cả</a>
        </div>
        <div class="fb-products">
            @foreach (var sp in lienQuan)
            {
                @Html.Partial("_TheSanPham", sp)
            }
        </div>
    </section>
}
