@model ShopHoaQua.Controllers.TrangChuViewModel
@{
    ViewBag.TieuDeTrang = "Trang chủ";
}


<section class="fb-card fb-hero reveal">
    <div>
        <span class="fb-eyebrow"><i class="fas fa-seedling"></i> FruitBen mùa thu @DateTime.Now.Year</span>
        <h1>Trái cây tươi<br /><span>giao tận nhà</span></h1>
        <p>Tuyển chọn mỗi sáng từ nhà vườn VietGAP và các vùng trồng nổi tiếng thế giới. Đặt trước 16h, nhận ngay trong ngày tại TP. Hồ Chí Minh.</p>
        <div class="fb-hero-actions">
            <a class="fb-btn fb-btn-grad fb-btn-lg" href="@Url.Action("Index", "SanPham")">Khám phá ngay <i class="fas fa-arrow-right"></i></a>
            <a class="fb-btn fb-btn-outline fb-btn-lg" href="@Url.Action("Index", "SanPham", new { giamGia = true })">Đang giảm giá</a>
        </div>
    </div>
    <div class="fb-slider" aria-roledescription="carousel" aria-label="Ảnh trái cây nổi bật">
        <div class="fb-slide active"><img src="~/assets/img/banner.jpg" alt="Trái cây nhiều màu sắc" /><span class="fb-slide-caption">Hơn @Model.SoSanPham loại trái cây</span></div>
        <div class="fb-slide"><img src="~/assets/img/hero-bg-2.jpg" alt="Bát dâu tây tươi" /><span class="fb-slide-caption">Dâu tây Đà Lạt mới hái</span></div>
        <div class="fb-slide"><img src="~/assets/img/banner2.jpg" alt="Chanh vàng và chanh xanh" /><span class="fb-slide-caption">Họ cam quýt giàu vitamin C</span></div>
        <div class="fb-slide"><img src="~/assets/img/hero-bg-3.jpg" alt="Cam cắt lát" /><span class="fb-slide-caption">Cam vàng Navel Úc</span></div>
        <button type="button" class="fb-slider-nav prev" aria-label="Ảnh trước"><i class="fas fa-chevron-left"></i></button>
        <button type="button" class="fb-slider-nav next" aria-label="Ảnh sau"><i class="fas fa-chevron-right"></i></button>
        <div class="fb-dots"></div>
    </div>
</section>

<!-- 2. CAM KẾT -->
<section class="fb-features reveal">
    <div class="fb-feature"><i class="fas fa-leaf"></i><div><strong>Chuẩn VietGAP</strong><span>Nguồn gốc rõ ràng</span></div></div>
    <div class="fb-feature"><i class="fas fa-shipping-fast"></i><div><strong>Giao trong ngày</strong><span>Miễn phí từ 500.000đ</span></div></div>
    <div class="fb-feature"><i class="fas fa-undo-alt"></i><div><strong>Đổi trả 24 giờ</strong><span>Dập, hỏng đổi ngay</span></div></div>
    <div class="fb-feature"><i class="fas fa-headset"></i><div><strong>Hỗ trợ 8h – 21h</strong><span>Hotline 1900 1234</span></div></div>
</section>

<!-- 3. BĂNG RÔN ẢNH -->
<section class="fb-section reveal">
    <div class="fb-banner" style="background-image: url('@Url.Content("~/assets/img/abt.jpg")');">
        <div>
            <span class="fb-eyebrow">FruitBen mỗi ngày</span>
            <h2>Hôm nay ăn trái cây gì?</h2>
            <p>Giỏ trái cây theo mùa, cắt sẵn hoặc nguyên trái, đóng gói giữ lạnh.</p>
        </div>
        <a class="fb-btn fb-btn-white" href="@Url.Action("Index", "SanPham", new { sapXep = "banchay" })">Xem món bán chạy <i class="fas fa-arrow-right"></i></a>
    </div>
</section>

<!-- 4. DANH MỤC -->
<section class="fb-section reveal">
    <div class="fb-section-head">
        <div>
            <span class="fb-eyebrow">Danh mục</span>
            <h2>Chọn loại trái cây bạn thích</h2>
        </div>
        <a class="fb-btn fb-btn-grad" href="@Url.Action("Index", "SanPham")">Xem tất cả</a>
    </div>
    <div class="fb-cats">
        <a class="fb-cat" href="@Url.Action("Index", "SanPham", new { loai = ShopHoaQua.Controllers.HomeController.LOAI_NOI_DIA })">
            <div class="fb-cat-img"><img src="~/assets/img/products/xoai-cat.jpg" alt="Xoài cát Hòa Lộc" loading="lazy" /></div>
            <div class="fb-cat-body"><h3>Trái cây nội địa</h3><p>Xoài, sầu riêng, măng cụt từ các vùng trồng Việt Nam.</p><span class="fb-cat-count">@Model.SoNoiDia sản phẩm</span></div>
        </a>
        <a class="fb-cat" href="@Url.Action("Index", "SanPham", new { loai = ShopHoaQua.Controllers.HomeController.LOAI_NHAP_KHAU })">
            <div class="fb-cat-img"><img src="~/assets/img/products/tao-envy-nz.jpg" alt="Táo Envy New Zealand" loading="lazy" /></div>
            <div class="fb-cat-body"><h3>Trái cây nhập khẩu</h3><p>Táo, nho, kiwi từ New Zealand, Mỹ, Úc, Nhật.</p><span class="fb-cat-count">@Model.SoNhapKhau sản phẩm</span></div>
        </a>
        <a class="fb-cat" href="@Url.Action("Index", "SanPham", new { giamGia = true })">
            <div class="fb-cat-img"><img src="~/assets/img/products/dau-tay.jpg" alt="Dâu tây" loading="lazy" /></div>
            <div class="fb-cat-body"><h3>Đang giảm giá</h3><p>Giá tốt trong tuần, số lượng có hạn.</p><span class="fb-cat-count">@Model.SoDangGiam sản phẩm</span></div>
        </a>
        <a class="fb-cat" href="@Url.Action("Index", "SanPham", new { sapXep = "moinhat" })">
            <div class="fb-cat-img"><img src="~/assets/img/products/viet-quat-uc.jpg" alt="Việt quất Úc" loading="lazy" /></div>
            <div class="fb-cat-body"><h3>Hàng mới về</h3><p>Những loại vừa cập kho FruitBen.</p><span class="fb-cat-count">Cập nhật hằng ngày</span></div>
        </a>
    </div>
</section>

<!-- 5. ĐANG ĐƯỢC YÊU THÍCH -->
<section class="fb-section reveal">
    <div class="fb-section-head">
        <div>
            <span class="fb-eyebrow">Sản phẩm nổi bật</span>
            <h2>Đang được yêu thích</h2>
        </div>
        <a class="fb-btn fb-btn-grad" href="@Url.Action("Index", "SanPham", new { sapXep = "banchay" })">Xem thêm</a>
    </div>
    @if (Model.NoiBat.Any())
    {
        <div class="fb-products">
            @foreach (var sp in Model.NoiBat)
            {
                @Html.Partial("_TheSanPham", sp)
            }
        </div>
    }
    else
    {
        <div class="fb-card fb-empty"><i class="fas fa-apple-alt"></i><h3>Chưa có sản phẩm</h3><p>Cửa hàng đang cập nhật hàng mới.</p></div>
    }
</section>

@if (Model.MaNoiBat != null)
{
    var ma = Model.MaNoiBat;
    <!-- 6. KHUYẾN MÃI (lấy từ bảng Mã giảm giá) -->
    <section class="fb-section reveal">
        <div class="fb-promo">
            <div>
                <span class="fb-eyebrow">FruitBen ưu đãi</span>
                <h2>@ma.MoTaGiaTri@(ma.DonToiThieu > 0 ? " cho đơn từ " + ma.DonToiThieu.ToString("#,##0") + "đ" : "")</h2>
                <p>Nhập mã ở bước thanh toán, áp dụng cho mọi loại trái cây@(ma.NgayKetThuc.HasValue ? ", hạn dùng đến " + ma.NgayKetThuc.Value.ToString("dd/MM/yyyy") : "").</p>
                <span class="fb-voucher-chip"><i class="fas fa-ticket-alt"></i> @ma.Ma</span>
            </div>
            <a class="fb-btn fb-btn-white fb-btn-lg" href="@Url.Action("Index", "SanPham")">Mua ngay <i class="fas fa-arrow-right"></i></a>
        </div>
    </section>
}

@if (Model.DangGiam.Any())
{
    <!-- 7. ĐANG GIẢM GIÁ -->
    <section class="fb-section reveal">
        <div class="fb-section-head">
            <div>
                <span class="fb-eyebrow" style="color: var(--fb-red);"><i class="fas fa-fire"></i> Giá sốc</span>
                <h2>Giảm sâu tuần này</h2>
            </div>
            <a class="fb-btn fb-btn-soft" href="@Url.Action("Index", "SanPham", new { giamGia = true })">Tất cả ưu đãi</a>
        </div>
        <div class="fb-products">
            @foreach (var sp in Model.DangGiam)
            {
                @Html.Partial("_TheSanPham", sp)
            }
        </div>
    </section>
}

<!-- 8. VỀ FRUITBEN + SỐ LIỆU -->
<section class="fb-section reveal">
    <div class="fb-card fb-about-mini">
        <div>
            <span class="fb-eyebrow">Về FruitBen</span>
            <h2>Không chỉ là nơi mua trái cây</h2>
            <p>FruitBen đồng hành cùng gia đình bạn trong từng bữa ăn lành mạnh: chọn trái đúng độ chín, bảo quản lạnh từ kho đến tay bạn, và đổi ngay nếu trái không đạt.</p>
            <a class="fb-btn fb-btn-grad" href="@Url.Action("GioiThieu", "Home")">Tìm hiểu thêm <i class="fas fa-arrow-right"></i></a>
        </div>
        <div class="fb-stats">
            <div class="fb-stat"><strong>@Model.SoSanPham</strong><span>Loại trái cây</span></div>
            <div class="fb-stat"><strong>@Model.SoKhachHang</strong><span>Khách hàng</span></div>
            <div class="fb-stat"><strong>@Model.SoDonHoanThanh</strong><span>Đơn đã giao</span></div>
        </div>
    </div>
</section>

@if (Model.TinMoi.Any())
{
    <!-- 9. TIN TỨC -->
    <section class="fb-section reveal">
        <div class="fb-section-head">
            <div>
                <span class="fb-eyebrow">Góc FruitBen</span>
                <h2>Tin tức &amp; mẹo chọn trái cây</h2>
            </div>
            <a class="fb-btn fb-btn-soft" href="@Url.Action("Index", "TinTuc")">Xem tất cả</a>
        </div>
        <div class="fb-news">
            @foreach (var tin in Model.TinMoi)
            {
                @Html.Partial("_TheTinTuc", tin)
            }
        </div>
    </section>
}
