@using ShopHoaQua.Services
@{
    ViewBag.TieuDeTrang = "Chính sách vận chuyển";
}

<section class="fb-card fb-page-head">
    <div>
        <span class="fb-eyebrow"><i class="fas fa-truck"></i> Chính sách</span>
        <h1>Vận chuyển &amp; giao nhận</h1>
        <p>Phí giao hàng, thời gian nhận hàng và cách FruitBen đóng gói để trái cây đến tay bạn vẫn tươi.</p>
    </div>
    <img class="fb-page-head-img" src="~/assets/img/feature-bg.jpg" alt="Thùng trái cây chuẩn bị giao" />
</section>

<div class="fb-info-grid mt-4">
    <div class="fb-info"><i class="fas fa-city"></i><h3>TP. Hồ Chí Minh</h3><p>@CauHinhVanChuyen.PHI_NOI_THANH.ToString("#,##0")đ/đơn · đặt trước 16h giao trong ngày</p></div>
    <div class="fb-info"><i class="fas fa-map"></i><h3>Tỉnh/thành khác</h3><p>@CauHinhVanChuyen.PHI_TINH_KHAC.ToString("#,##0")đ/đơn · 1–3 ngày làm việc</p></div>
    <div class="fb-info"><i class="fas fa-gift"></i><h3>Miễn phí giao hàng</h3><p>Cho đơn có tạm tính từ @CauHinhVanChuyen.MIEN_PHI_TU.ToString("#,##0")đ, mọi tỉnh thành</p></div>
</div>

<section class="fb-card fb-card-pad mt-4">
    <div class="fb-prose">
        <h2>1. Bảng phí vận chuyển</h2>
        <div class="fb-table-wrap">
            <table class="fb-table">
                <thead><tr><th>Khu vực</th><th>Tạm tính dưới @CauHinhVanChuyen.MIEN_PHI_TU.ToString("#,##0")đ</th><th>Từ @CauHinhVanChuyen.MIEN_PHI_TU.ToString("#,##0")đ</th><th>Thời gian</th></tr></thead>
                <tbody>
                    <tr><td>TP. Hồ Chí Minh</td><td>@CauHinhVanChuyen.PHI_NOI_THANH.ToString("#,##0")đ</td><td>Miễn phí</td><td>Trong ngày (đặt trước 16h)</td></tr>
                    <tr><td>33 tỉnh/thành còn lại</td><td>@CauHinhVanChuyen.PHI_TINH_KHAC.ToString("#,##0")đ</td><td>Miễn phí</td><td>1–3 ngày làm việc</td></tr>
                </tbody>
            </table>
        </div>
        <h2>2. Đóng gói</h2>
        <ul>
            <li>Trái mềm (dâu, nho, việt quất) đựng hộp nhựa cứng có lỗ thoáng.</li>
            <li>Đơn đi tỉnh đóng thùng xốp kèm đá gel, giữ 2–8°C trong 48 giờ.</li>
            <li>Sầu riêng, mít bọc màng co để không bay mùi sang trái khác.</li>
        </ul>
        <h2>3. Khi nhận hàng</h2>
        <ul>
            <li>Kiểm tra số lượng và tình trạng trái trước khi ký nhận.</li>
            <li>Nếu trái dập, hỏng: chụp ảnh và báo FruitBen trong 24 giờ để được đổi (xem <a href="@Url.Action("DoiTra")">chính sách đổi trả</a>).</li>
            <li>Không liên lạc được người nhận sau 2 lần gọi, đơn được hẹn giao lại ngày hôm sau.</li>
        </ul>
    </div>
</section>
