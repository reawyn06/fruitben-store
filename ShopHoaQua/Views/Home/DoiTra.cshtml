@{
    ViewBag.TieuDeTrang = "Chính sách đổi trả";
}

<section class="fb-card fb-page-head">
    <div>
        <span class="fb-eyebrow"><i class="fas fa-undo-alt"></i> Chính sách</span>
        <h1>Đổi trả trong 24 giờ</h1>
        <p>Trái cây là hàng tươi sống, nên FruitBen nhận đổi trả nhanh để bạn yên tâm mua sắm.</p>
    </div>
    <img class="fb-page-head-img" src="~/assets/img/hero-bg-3.jpg" alt="Cam cắt lát" />
</section>

<div class="fb-info-grid mt-4">
    <div class="fb-info"><i class="fas fa-camera"></i><h3>1. Chụp ảnh</h3><p>Chụp trái bị dập, hỏng và tem đơn hàng ngay khi phát hiện.</p></div>
    <div class="fb-info"><i class="fas fa-phone"></i><h3>2. Báo FruitBen</h3><p>Gọi 1900 1234 hoặc gửi trang Liên hệ trong vòng 24 giờ sau khi nhận.</p></div>
    <div class="fb-info"><i class="fas fa-sync-alt"></i><h3>3. Đổi hoặc hoàn tiền</h3><p>Giao trái mới miễn phí, hoặc hoàn tiền phần hư hỏng trong 1–3 ngày.</p></div>
</div>

<section class="fb-card fb-card-pad mt-4">
    <div class="fb-prose">
        <h2>Được đổi trả khi</h2>
        <ul>
            <li>Trái bị dập, úng, thối, có côn trùng khi nhận hàng.</li>
            <li>Giao sai loại hoặc thiếu số kg so với đơn.</li>
            <li>Trái nhập khẩu không đúng xuất xứ ghi trên trang sản phẩm.</li>
        </ul>
        <h2>Không áp dụng khi</h2>
        <ul>
            <li>Báo sau 24 giờ kể từ lúc nhận hàng.</li>
            <li>Trái đã ăn quá một nửa hoặc bảo quản sai hướng dẫn (ví dụ để dâu ngoài nắng).</li>
            <li>Khác biệt nhỏ về kích cỡ, màu sắc tự nhiên giữa các trái.</li>
        </ul>
        <h2>Hoàn tiền</h2>
        <p>Đơn COD hoàn bằng chuyển khoản; đơn đã chuyển khoản QR hoàn về đúng tài khoản đã chuyển. Đơn bị huỷ trước khi giao được hoàn toàn bộ, kể cả phí vận chuyển.</p>
    </div>
</section>
