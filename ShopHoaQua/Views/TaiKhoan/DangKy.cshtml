@model ShopHoaQua.Models.DangKyViewModel
@{
    ViewBag.TieuDeTrang = "Đăng ký";
    ViewBag.Banner = "Thành viên mới";          // banner đầu trang (giao diện mẫu Fruitkha)
    ViewBag.BannerTieuDe = "Đăng ký tài khoản";
}

<section class="fb-card fb-auth">
    <div class="fb-auth-side" style="background-image: url('@Url.Content("~/assets/img/banner2.jpg")');">
        <span class="fb-eyebrow">Mới tại FruitBen?</span>
        <h2>Tạo tài khoản miễn phí</h2>
        <p>Lưu địa chỉ giao hàng, xem lại lịch sử đơn và tự huỷ đơn khi chưa xử lý.</p>
    </div>

    <div class="fb-auth-form">
        <span class="fb-eyebrow"><i class="fas fa-user-plus"></i> Đăng ký</span>
        <h1>Tạo tài khoản</h1>
        <p class="text-muted">Đã có tài khoản? <a href="@Url.Action("DangNhap")" class="font-weight-bold">Đăng nhập</a></p>

        @using (Html.BeginForm("DangKy", "TaiKhoan", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "fb-note-box mb-3", style = "background: var(--fb-red-soft); border-color: #f7caca; color: var(--fb-red); font-weight: 600;" })

            <div class="fb-field">
                @Html.LabelFor(m => m.HoTen)
                <div class="fb-input-icon"><i class="far fa-user"></i>
                    @Html.TextBoxFor(m => m.HoTen, new { @class = "fb-control", placeholder = "Nguyễn Văn A", autocomplete = "name" })
                </div>
                @Html.ValidationMessageFor(m => m.HoTen)
            </div>

            <div class="form-row">
                <div class="col-md-7 fb-field">
                    @Html.LabelFor(m => m.Email)
                    <div class="fb-input-icon"><i class="far fa-envelope"></i>
                        @Html.TextBoxFor(m => m.Email, new { @class = "fb-control", placeholder = "ban@gmail.com", type = "email", autocomplete = "email" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email)
                </div>
                <div class="col-md-5 fb-field">
                    <label for="SoDienThoai">Số điện thoại <small class="text-muted">(tuỳ chọn)</small></label>
                    <div class="fb-input-icon"><i class="fas fa-phone"></i>
                        @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "fb-control", placeholder = "0901234567", inputmode = "tel", autocomplete = "tel" })
                    </div>
                    @Html.ValidationMessageFor(m => m.SoDienThoai)
                </div>
            </div>

            <div class="fb-field">
                @Html.LabelFor(m => m.MatKhau)
                <div class="fb-input-icon" style="position: relative;"><i class="fas fa-lock"></i>
                    @Html.PasswordFor(m => m.MatKhau, new { @class = "fb-control", placeholder = "Ít nhất 6 ký tự", autocomplete = "new-password", data_strength = "doManh" })
                    <button type="button" class="fb-pass-toggle" data-toggle-pass="MatKhau" aria-label="Hiện mật khẩu"><i class="far fa-eye"></i></button>
                </div>
                <div class="fb-strength" id="doManh"><span></span><span></span><span></span><span></span></div>
                <div class="fb-strength-text" id="doManhText">Nên dùng ít nhất 6 ký tự, có chữ hoa, chữ thường và số.</div>
                @Html.ValidationMessageFor(m => m.MatKhau)
            </div>

            <div class="fb-field">
                @Html.LabelFor(m => m.XacNhanMatKhau)
                <div class="fb-input-icon"><i class="fas fa-lock"></i>
                    @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "fb-control", placeholder = "Nhập lại mật khẩu", autocomplete = "new-password" })
                </div>
                @Html.ValidationMessageFor(m => m.XacNhanMatKhau)
            </div>

            <button type="submit" class="fb-btn fb-btn-grad fb-btn-lg fb-btn-block">Tạo tài khoản <i class="fas fa-arrow-right"></i></button>
        }
    </div>
</section>
